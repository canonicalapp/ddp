{
  "name": "@advcomm/ddp",
  "version": "3.1.0",
  "description": "Declarative Database Provisioning - DDP CLI tool",
  "main": "dist/cli.js",
  "bin": {
    "ddp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "build:clean": "rm -rf dist && npm run build",
    "type-check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:integration:live": "tsx tests/run-integration-tests.ts run",
    "test:integration:setup": "tsx tests/setup-test-db.ts setup",
    "test:integration:cleanup": "tsx tests/setup-test-db.ts cleanup",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "start": "node dist/cli.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "check:all": "npm run check && npm run test:ci",
    "npm:versions": "npm view @advcomm/ddp versions --json",
    "npm:latest": "npm view @advcomm/ddp version",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "clean": "npm run clean:test-output && npm run clean:output && npm run clean:dist && npm run clean:temp",
    "clean:test-output": "rm -rf test-output/",
    "clean:output": "rm -rf output/ custom-output/",
    "clean:dist": "rm -rf dist/",
    "clean:temp": "find . -name '*.sql' -not -path './test-database-*.sql' -not -path './docs/*' -not -path './tests/fixtures/*' -delete && find . -name '*.log' -delete && find . -name '.DS_Store' -delete",
    "clean:all": "npm run clean && find . -name 'schema-sync_*' -delete && find . -name 'alter_*' -delete",
    "test:clean": "npm run test && npm run clean",
    "gen:clean": "npm run dev gen -- --help && npm run clean",
    "sync:clean": "npm run dev sync -- --help && npm run clean",
    "clean:quick": "rm -rf test-output/ output/ custom-output/ && find . -name 'alter.sql' -delete",
    "clean:deep": "npm run clean:all && rm -rf node_modules/ && npm install",
    "clean:logs": "find . -name '*.log' -delete && find . -name 'npm-debug.log*' -delete",
    "clean:coverage": "rm -rf coverage/",
    "clean:build": "rm -rf dist/ && npm run build",
    "prepare": "husky",
    "prepublishOnly": "npm run build && node scripts/assert-npm-version.cjs"
  },
  "keywords": [
    "postgresql",
    "database",
    "schema",
    "migration",
    "sync",
    "cli",
    "ddp",
    "declarative",
    "provisioning",
    "postgres",
    "sql",
    "database-management",
    "schema-generation",
    "database-sync"
  ],
  "author": {
    "name": "advcomm",
    "email": "dev2@advcomm.ca"
  },
  "license": "MIT",
  "homepage": "https://github.com/canonicalapp/ddp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonicalapp/ddp.git"
  },
  "bugs": {
    "url": "https://github.com/canonicalapp/ddp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "dependencies": {
    "commander": "^14.0.0",
    "consola": "^3.4.2",
    "find-up": "^7.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "baseline-browser-mapping": "^2.10.23",
    "dotenv": "^17.2.2",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "semantic-release": "^25.0.3",
    "semver": "^7.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
